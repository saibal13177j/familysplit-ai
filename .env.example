# Supabase project settings (Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: only needed if you wire up the AI features (see src/services/ai).
# NEVER put a secret AI provider key in a VITE_ variable - it would ship to the
# browser. If your AI provider needs a secret key, call it from a Supabase Edge
# Function instead and leave this blank on the client.
VITE_AI_FEATURES_ENABLED=false
